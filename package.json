{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "life-os": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --cwd \"$PWD/ui\" dev -- --host 127.0.0.1",
    "start": "HOST=127.0.0.1 bun run --cwd \"$PWD/ui\" start",
    "cli": "bun run src/cli.ts",
    "doctor": "bun run src/cli.ts doctor",
    "state:rebuild": "bun run src/cli.ts state rebuild",
    "mcp": "bun run src/mcp/server.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "ui:check": "bun run --cwd \"$PWD/ui\" check",
    "ui:test": "bun run --cwd \"$PWD/ui\" test",
    "ui:build": "bun run --cwd \"$PWD/ui\" build",
    "privacy:smoke": "bun run scripts/privacy-smoke.ts",
    "release:check": "bun run typecheck && bun test && bun run ui:check && bun run ui:test && bun run ui:build && bun run privacy:smoke"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/html-to-text": "^9.0.4",
    "typescript": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "html-to-text": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
